# Production settings for docker-compose.prod.yml. Copy to .env.prod (git-ignored) and replace every value.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AEGIS_DOMAIN=aegis.example.tech
ACME_EMAIL=ops@example.tech
AEGIS_CORS_ORIGINS=https://aegis.example.tech
POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
AEGIS_JWT_SECRET=change-me-to-48-random-characters
AEGIS_MASTER_KEY=change-me-device-key-master-secret
AEGIS_KEY_SECRET=change-me-device-key-encryption-secret
# publisher id : batch-signing key (the Reality Emulator or a real gateway)
AEGIS_PUBLISHERS=reality-emulator:change-me-publisher-key
# initial users (argon2-hashed on first start); use long passwords, then manage users via /api/v1/auth/users
AEGIS_USERS=admin:admin:change-me-long-password,planner:planner:change-me-long-password
AEGIS_ACCESS_TTL_S=900
AEGIS_REFRESH_TTL_S=604800
AEGIS_TWIN_WARMUP_H=58
# optional: Claude for the Copilot (otherwise the offline planner answers)
# ANTHROPIC_API_KEY=
